{
  "manifest_version": 3,
  "name": "WaveRPC",
  "version": "0.3.0",
  "version_name": "0.3.0-alpha.0",
  "description": "Universal music Rich Presence extension for Discord",
  "permissions": ["activeTab"],
  "host_permissions": ["*://*.soundcloud.com/*"],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.soundcloud.com/*"],
      "js": ["dist/content/soundcloud.js"]
    }
  ]
}
